# Copy this file to .env (which is gitignored) and fill in real values.

# Sanity (after running `sanity init` in ./sanity-studio)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Cliniko booking iframe — already hardcoded in BookingBlock.astro,
# but you can move to env if you want to swap embeds later
# PUBLIC_CLINIKO_EMBED_URL=https://forward-health-group.au2.cliniko.com/bookings?embedded=true

# Plausible / Google Analytics — when you decide on tracking
# PUBLIC_ANALYTICS_DOMAIN=fwdhealth.com.au

# ---- Gift cards (Netlify Functions: create-checkout-session, stripe-webhook, admin-gift-cards) ----

# Stripe
# Get keys from https://dashboard.stripe.com/apikeys
# Use test keys for local, live keys in Netlify prod env
STRIPE_SECRET_KEY=sk_test_...
# After creating a webhook endpoint in Stripe (https://dashboard.stripe.com/webhooks)
# pointed at /.netlify/functions/stripe-webhook, listening for checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (also used by the referral form)
RESEND_API_KEY=re_...
# Optional: once your fwdhealth.com.au domain is verified in Resend, set this to e.g.
# RESEND_FROM_EMAIL="Forward Health Gifts <gifts@fwdhealth.com.au>"
# If unset, defaults to onboarding@resend.dev (Resend's sandbox sender).
RESEND_FROM_EMAIL=

# Public site URL (used to build Stripe success/cancel URLs)
SITE_URL=https://www.fwdhealth.com.au

# Admin dashboard password (basic-auth password at /admin/gift-cards; username is always "admin")
ADMIN_PASSWORD=change-me

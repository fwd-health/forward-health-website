---
// Bump the version to re-show the popup to visitors who dismissed the previous one
const POPUP_VERSION = "2026-07-currimundi-move-v2";

// Auto-expire: after this date, the popup never shows again (even for first-time visitors).
// Set for 30 days from launch; adjust or remove for future announcements.
const EXPIRES_AT = "2026-08-27T23:59:59+10:00";

const directionsUrl =
  "https://www.google.com/maps/dir/?api=1&destination=698+Nicklin+Way+Currimundi+QLD+4551";
---

<dialog
  id="fh-announce"
  data-version={POPUP_VERSION}
  data-expires={EXPIRES_AT}
  class="fixed inset-0 m-auto p-0 max-w-xl w-[calc(100%-2rem)] max-h-[92vh] bg-cream-50 rounded-3xl border border-sage-100 shadow-2xl backdrop:bg-charcoal/60 backdrop:backdrop-blur-sm overflow-hidden"
  aria-labelledby="fh-announce-title"
>
  <button
    type="button"
    data-fh-announce-close
    aria-label="Close announcement"
    class="absolute top-4 right-4 z-10 w-10 h-10 rounded-full bg-white/90 backdrop-blur border border-sage-100 hover:bg-white text-charcoal flex items-center justify-center text-xl"
  >
    ×
  </button>

  <div class="overflow-y-auto max-h-[92vh] px-6 py-10 lg:px-10 lg:py-12 text-center">
    <p
      class="font-display font-bold text-charcoal uppercase tracking-[0.12em] leading-none"
      style="font-size: clamp(1.25rem, 3.5vw, 1.75rem);"
    >
      Currimundi clinic
    </p>

    <h2
      id="fh-announce-title"
      class="mt-3 font-display text-sage-600 font-bold leading-[1.0]"
      style="font-size: clamp(2.5rem, 7vw, 4rem);"
    >
      We're moving!
    </h2>
    <p class="mt-3 text-stone text-base lg:text-lg">
      (1 minute up the road)
    </p>

    <div class="mt-8 py-6 border-y border-sage-200">
      <p class="text-sm uppercase tracking-[0.14em] text-tan-700 font-semibold">
        From Monday, 3 August 2026
      </p>
      <p class="mt-4 text-sm text-stone">Our new home:</p>
      <p
        class="mt-2 font-display font-bold text-sage-700 leading-tight"
        style="font-size: clamp(1.75rem, 4.5vw, 2.5rem);"
      >
        698 Nicklin Way
      </p>
      <p class="text-charcoal text-base lg:text-lg">
        Currimundi QLD 4551
      </p>
    </div>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href={directionsUrl}
        target="_blank"
        rel="noopener"
        data-fh-announce-close
        class="inline-flex items-center rounded-full bg-sage-600 px-6 py-3 text-sm font-semibold text-white hover:bg-sage-700 transition-colors"
      >
        Get directions →
      </a>
      <button
        type="button"
        data-fh-announce-close
        class="inline-flex items-center rounded-full bg-white border border-sage-200 px-6 py-3 text-sm font-semibold text-charcoal hover:border-sage-400 transition-colors"
      >
        Close
      </button>
    </div>

    <div class="mt-8 text-xs text-stone">
      <p class="uppercase tracking-[0.14em] font-semibold text-tan-600 mb-2">Questions?</p>
      <p>
        <a href="tel:0420522558" class="text-charcoal hover:text-sage-600">0420 522 558</a>
        <span class="mx-2 text-sage-300">·</span>
        <a href="mailto:hello@fwdhealth.com.au" class="text-charcoal hover:text-sage-600">hello@fwdhealth.com.au</a>
      </p>
    </div>
  </div>
</dialog>

<script is:inline define:vars={{ POPUP_VERSION, EXPIRES_AT }}>
  (function () {
    const KEY = "fh-announce-dismissed";
    const dialog = document.getElementById("fh-announce");
    if (!dialog) return;

    // Hard expiry — after this date the popup never shows again, even to first-timers.
    if (new Date() > new Date(EXPIRES_AT)) return;

    const seen = (() => {
      try { return localStorage.getItem(KEY); } catch (e) { return null; }
    })();

    if (seen !== POPUP_VERSION) {
      setTimeout(() => {
        if (typeof dialog.showModal === "function") dialog.showModal();
      }, 800);
    }

    const close = () => {
      try { localStorage.setItem(KEY, POPUP_VERSION); } catch (e) {}
      dialog.close();
    };

    dialog.addEventListener("click", (e) => {
      const t = e.target;
      if (t === dialog) { close(); return; }
      if (t.closest && t.closest("[data-fh-announce-close]")) close();
    });

    dialog.addEventListener("close", () => {
      try { localStorage.setItem(KEY, POPUP_VERSION); } catch (e) {}
    });
  })();
</script>

<style>
  dialog#fh-announce[open] {
    animation: fhAnnounceFadeIn 0.22s ease-out;
  }
  dialog#fh-announce[open]::backdrop {
    animation: fhAnnounceBackdropFadeIn 0.22s ease-out;
  }
  @keyframes fhAnnounceFadeIn {
    from { opacity: 0; transform: translateY(8px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes fhAnnounceBackdropFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  body:has(dialog#fh-announce[open]) {
    overflow: hidden;
  }
</style>

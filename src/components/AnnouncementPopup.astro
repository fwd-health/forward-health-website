---
// Bump the version to re-show the popup to visitors who dismissed the previous one
const POPUP_VERSION = "2026-12-gift-cards-v1";

// Auto-expire: after this date, the popup never shows again (even for first-time visitors).
const EXPIRES_AT = "2026-12-24T23:59:59+10:00";

const giftCardsUrl = "/gift-cards";
---

<dialog
  id="fh-announce"
  data-version={POPUP_VERSION}
  data-expires={EXPIRES_AT}
  class="fixed inset-0 m-auto p-0 max-w-xl w-[calc(100%-2rem)] max-h-[92vh] bg-cream-50 rounded-3xl border border-sage-100 shadow-2xl backdrop:bg-charcoal/60 backdrop:backdrop-blur-sm overflow-hidden"
  aria-labelledby="fh-announce-title"
>
  <button
    type="button"
    data-fh-announce-close
    aria-label="Close announcement"
    class="absolute top-4 right-4 z-10 w-10 h-10 rounded-full bg-white/90 backdrop-blur border border-sage-100 hover:bg-white text-charcoal flex items-center justify-center text-xl"
  >
    ×
  </button>

  <!-- Decorative sprig top-left (SVG) -->
  <svg
    aria-hidden="true"
    class="absolute top-4 left-4 w-12 h-12 text-sage-600/70"
    viewBox="0 0 48 48"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M24 44 V14" />
    <path d="M24 20 L15 16" />
    <path d="M24 20 L33 16" />
    <path d="M24 28 L13 22" />
    <path d="M24 28 L35 22" />
    <path d="M24 36 L15 30" />
    <path d="M24 36 L33 30" />
    <circle cx="20" cy="40" r="1.6" fill="currentColor" stroke="none" />
    <circle cx="28" cy="40" r="1.6" fill="currentColor" stroke="none" />
    <circle cx="24" cy="43" r="1.6" fill="currentColor" stroke="none" />
  </svg>

  <div class="overflow-y-auto max-h-[92vh] px-6 py-10 lg:px-10 lg:py-12 text-center">
    <p
      class="font-display font-bold text-tan-700 uppercase tracking-[0.18em] leading-none"
      style="font-size: clamp(0.75rem, 2vw, 0.875rem);"
    >
      Christmas 2026
    </p>

    <h2
      id="fh-announce-title"
      class="mt-4 font-display text-sage-700 font-bold leading-[1.0]"
      style="font-size: clamp(1.75rem, 5vw, 2.75rem);"
    >
      Give the gift of health.
    </h2>
    <p class="mt-4 text-stone text-base lg:text-lg leading-relaxed max-w-md mx-auto">
      Digital gift cards for massage and Pilates at Forward Health, delivered by email in minutes.
    </p>

    <div class="mt-7 py-5 border-y border-sage-200">
      <div class="grid grid-cols-3 gap-3 text-sm">
        <div>
          <p class="font-display text-xl text-sage-700 font-bold">$87+</p>
          <p class="text-xs text-stone mt-0.5 leading-tight">Remedial massage</p>
        </div>
        <div class="border-x border-sage-200">
          <p class="font-display text-xl text-sage-700 font-bold">$269</p>
          <p class="text-xs text-stone mt-0.5 leading-tight">3-class Pilates starter</p>
        </div>
        <div>
          <p class="font-display text-xl text-sage-700 font-bold">$377</p>
          <p class="text-xs text-stone mt-0.5 leading-tight">6-class Pilates starter</p>
        </div>
      </div>
    </div>

    <p class="mt-5 text-xs text-tan-700 font-semibold uppercase tracking-[0.1em]">
      Email to a friend, or print it yourself
    </p>

    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a
        href={giftCardsUrl}
        data-fh-announce-close
        class="inline-flex items-center rounded-full bg-sage-600 px-6 py-3 text-sm font-semibold text-white hover:bg-sage-700 transition-colors"
      >
        Shop gift cards →
      </a>
      <button
        type="button"
        data-fh-announce-close
        class="inline-flex items-center rounded-full bg-white border border-sage-200 px-6 py-3 text-sm font-semibold text-charcoal hover:border-sage-400 transition-colors"
      >
        Maybe later
      </button>
    </div>

    <p class="mt-6 text-xs text-stone">
      Redeemable in-clinic for 3 years · Currimundi &amp; Sandstone Point
    </p>
  </div>
</dialog>

<script is:inline define:vars={{ POPUP_VERSION, EXPIRES_AT }}>
  (function () {
    const KEY = "fh-announce-dismissed";
    const dialog = document.getElementById("fh-announce");
    if (!dialog) return;

    // Hard expiry — after this date the popup never shows again, even to first-timers.
    if (new Date() > new Date(EXPIRES_AT)) return;

    const seen = (() => {
      try { return localStorage.getItem(KEY); } catch (e) { return null; }
    })();

    if (seen !== POPUP_VERSION) {
      setTimeout(() => {
        if (typeof dialog.showModal === "function") dialog.showModal();
      }, 800);
    }

    const close = () => {
      try { localStorage.setItem(KEY, POPUP_VERSION); } catch (e) {}
      dialog.close();
    };

    dialog.addEventListener("click", (e) => {
      const t = e.target;
      if (t === dialog) { close(); return; }
      if (t.closest && t.closest("[data-fh-announce-close]")) close();
    });

    dialog.addEventListener("close", () => {
      try { localStorage.setItem(KEY, POPUP_VERSION); } catch (e) {}
    });
  })();
</script>

<style>
  dialog#fh-announce[open] {
    animation: fhAnnounceFadeIn 0.22s ease-out;
  }
  dialog#fh-announce[open]::backdrop {
    animation: fhAnnounceBackdropFadeIn 0.22s ease-out;
  }
  @keyframes fhAnnounceFadeIn {
    from { opacity: 0; transform: translateY(8px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes fhAnnounceBackdropFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  body:has(dialog#fh-announce[open]) {
    overflow: hidden;
  }
</style>

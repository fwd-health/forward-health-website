---
import Layout from "../../layouts/Layout.astro";
import { GIFT_CARD_SERVICES, GIFT_CARD_EXPIRY_YEARS } from "../../data/gift-cards.js";
---

<Layout
  title="Gift cards | Forward Health"
  description="Give the gift of health this Christmas. Forward Health digital gift cards for remedial massage and clinical pilates at our Currimundi and Sandstone Point clinics. Redeemable in-clinic for 3 years."
>
  <!-- Hero -->
  <section class="bg-sage-50">
    <div class="max-w-5xl mx-auto px-5 lg:px-8 py-16 lg:py-20 text-center">
      <p class="text-sm uppercase tracking-[0.18em] text-tan-600 mb-4">Forward Health gift cards</p>
      <h1 class="text-charcoal font-display">
        Give the gift of health <br class="hidden sm:inline" />this Christmas.
      </h1>
      <p class="mt-6 text-lg text-stone leading-relaxed max-w-2xl mx-auto">
        A hands-on massage, or the start of their Pilates journey, chosen by them, delivered by
        our team. Buy online, email it to a friend or print it yourself, redeemable at both
        clinics for {GIFT_CARD_EXPIRY_YEARS} years.
      </p>
    </div>
  </section>

  <!-- Form -->
  <form id="gift-card-form" class="max-w-4xl mx-auto px-5 lg:px-8 py-14 lg:py-20 space-y-12">
    <!-- Step 1: Service -->
    <section>
      <div class="flex items-baseline justify-between mb-5">
        <div>
          <p class="text-xs uppercase tracking-[0.18em] text-tan-600 mb-1.5">Step 1</p>
          <h2 class="text-2xl lg:text-3xl text-charcoal">Choose the gift.</h2>
        </div>
      </div>
      <div class="grid md:grid-cols-2 gap-4" role="radiogroup" aria-label="Choose a service">
        {GIFT_CARD_SERVICES.map((s, i) => (
          <label
            class="relative cursor-pointer p-5 rounded-2xl border-2 border-sage-100 bg-white hover:border-sage-300 transition-all has-[:checked]:border-sage-600 has-[:checked]:bg-sage-50/60 has-[:checked]:shadow-sm block"
          >
            <input
              type="radio"
              name="serviceId"
              value={s.id}
              checked={i === 0}
              required
              class="sr-only peer"
            />
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="font-display text-xl text-charcoal leading-tight">{s.short}</h3>
                <p class="mt-1.5 text-sm text-stone leading-relaxed">{s.description}</p>
              </div>
              <p class="shrink-0 font-display text-2xl text-sage-700">${s.priceAud}</p>
            </div>
            <ul class="mt-4 space-y-1.5">
              {s.includes.map((inc) => (
                <li class="text-xs text-stone flex gap-2">
                  <span class="mt-1.5 w-1 h-1 shrink-0 rounded-full bg-sage-500"></span>
                  <span>{inc}</span>
                </li>
              ))}
            </ul>
            <span
              class="absolute top-4 right-4 w-5 h-5 rounded-full border-2 border-sage-300 peer-checked:border-sage-600 peer-checked:bg-sage-600 after:content-[''] after:absolute after:inset-[3px] after:rounded-full after:bg-white after:scale-0 peer-checked:after:scale-100 after:transition-transform"
            ></span>
          </label>
        ))}
      </div>
      <p class="mt-5 text-xs text-stone leading-relaxed">
        <span class="text-tan-700 font-semibold">*</span>
        Recipients new to our Clinical Pilates classes <strong>must</strong> book a
        1-on-1 Pilates pre-screen with a physio before attending group classes. The
        pre-screen packs above include this — the standalone packs don't.
      </p>
    </section>

    <!-- Step 2: Delivery method -->
    <section>
      <p class="text-xs uppercase tracking-[0.18em] text-tan-600 mb-1.5">Step 2</p>
      <h2 class="text-2xl lg:text-3xl text-charcoal mb-5">How should we deliver it?</h2>
      <div class="grid sm:grid-cols-2 gap-4" role="radiogroup" aria-label="Delivery method">
        <label
          class="cursor-pointer p-5 rounded-2xl border-2 border-sage-100 bg-white hover:border-sage-300 transition-all has-[:checked]:border-sage-600 has-[:checked]:bg-sage-50/60 relative block"
        >
          <input
            type="radio"
            name="deliveryMethod"
            value="email-friend"
            checked
            required
            class="sr-only peer"
          />
          <h3 class="font-display text-lg text-charcoal">Email it to a friend</h3>
          <p class="mt-1.5 text-sm text-stone">
            We'll email the gift card straight to your recipient on the day you choose.
          </p>
          <span
            class="absolute top-4 right-4 w-5 h-5 rounded-full border-2 border-sage-300 peer-checked:border-sage-600 peer-checked:bg-sage-600 after:content-[''] after:absolute after:inset-[3px] after:rounded-full after:bg-white after:scale-0 peer-checked:after:scale-100 after:transition-transform"
          ></span>
        </label>
        <label
          class="cursor-pointer p-5 rounded-2xl border-2 border-sage-100 bg-white hover:border-sage-300 transition-all has-[:checked]:border-sage-600 has-[:checked]:bg-sage-50/60 relative block"
        >
          <input
            type="radio"
            name="deliveryMethod"
            value="email-me-to-print"
            required
            class="sr-only peer"
          />
          <h3 class="font-display text-lg text-charcoal">Email it to me to print</h3>
          <p class="mt-1.5 text-sm text-stone">
            We'll email the gift card to you, so you can print it and hand it over in person.
          </p>
          <span
            class="absolute top-4 right-4 w-5 h-5 rounded-full border-2 border-sage-300 peer-checked:border-sage-600 peer-checked:bg-sage-600 after:content-[''] after:absolute after:inset-[3px] after:rounded-full after:bg-white after:scale-0 peer-checked:after:scale-100 after:transition-transform"
          ></span>
        </label>
      </div>
    </section>

    <!-- Step 3: Details -->
    <section>
      <p class="text-xs uppercase tracking-[0.18em] text-tan-600 mb-1.5">Step 3</p>
      <h2 class="text-2xl lg:text-3xl text-charcoal mb-5">Who's it for?</h2>

      <div class="grid md:grid-cols-2 gap-5">
        <div>
          <label for="buyerName" class="text-sm font-semibold text-charcoal">Your name</label>
          <input
            type="text"
            id="buyerName"
            name="buyerName"
            required
            autocomplete="name"
            class="mt-1.5 w-full rounded-xl border-2 border-sage-100 bg-white px-4 py-3 text-charcoal focus:border-sage-500 focus:outline-none"
          />
        </div>
        <div>
          <label for="buyerEmail" class="text-sm font-semibold text-charcoal">Your email</label>
          <input
            type="email"
            id="buyerEmail"
            name="buyerEmail"
            required
            autocomplete="email"
            class="mt-1.5 w-full rounded-xl border-2 border-sage-100 bg-white px-4 py-3 text-charcoal focus:border-sage-500 focus:outline-none"
          />
          <p class="mt-1 text-xs text-stone">We'll send the receipt here.</p>
        </div>
        <div>
          <label for="recipientName" class="text-sm font-semibold text-charcoal">Recipient's name</label>
          <input
            type="text"
            id="recipientName"
            name="recipientName"
            required
            class="mt-1.5 w-full rounded-xl border-2 border-sage-100 bg-white px-4 py-3 text-charcoal focus:border-sage-500 focus:outline-none"
          />
        </div>
        <div id="recipientEmailWrap">
          <label for="recipientEmail" class="text-sm font-semibold text-charcoal">Recipient's email</label>
          <input
            type="email"
            id="recipientEmail"
            name="recipientEmail"
            class="mt-1.5 w-full rounded-xl border-2 border-sage-100 bg-white px-4 py-3 text-charcoal focus:border-sage-500 focus:outline-none"
          />
          <p class="mt-1 text-xs text-stone">Only needed if we're emailing it to them.</p>
        </div>
        <div class="md:col-span-2">
          <label for="personalMessage" class="text-sm font-semibold text-charcoal">
            Personal message <span class="text-stone font-normal">(optional)</span>
          </label>
          <textarea
            id="personalMessage"
            name="personalMessage"
            rows="3"
            maxlength="400"
            placeholder="A note from you — this prints on the gift card."
            class="mt-1.5 w-full rounded-xl border-2 border-sage-100 bg-white px-4 py-3 text-charcoal focus:border-sage-500 focus:outline-none resize-none"
          ></textarea>
        </div>
        <div class="md:col-span-2" id="sendOnWrap">
          <label for="sendOn" class="text-sm font-semibold text-charcoal">
            Send on <span class="text-stone font-normal">(optional — leave blank to send immediately)</span>
          </label>
          <input
            type="date"
            id="sendOn"
            name="sendOn"
            class="mt-1.5 w-full md:w-auto rounded-xl border-2 border-sage-100 bg-white px-4 py-3 text-charcoal focus:border-sage-500 focus:outline-none"
          />
          <p class="mt-1 text-xs text-stone">For example, Christmas morning.</p>
        </div>
      </div>
    </section>

    <!-- Summary + CTA -->
    <section class="rounded-3xl bg-cream-50 border border-sage-100 p-6 lg:p-8">
      <div class="flex flex-wrap items-center justify-between gap-5">
        <div>
          <p class="text-xs uppercase tracking-[0.18em] text-tan-700 font-semibold">Total</p>
          <p id="summary-total" class="font-display text-3xl text-charcoal mt-1">$269</p>
          <p id="summary-service" class="text-sm text-stone mt-0.5">3-class Pilates pack</p>
        </div>
        <button
          type="submit"
          id="submitBtn"
          class="inline-flex items-center justify-center rounded-full bg-sage-600 px-8 py-4 text-base font-semibold text-white hover:bg-sage-700 transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
        >
          <span data-label-default>Continue to payment →</span>
          <span data-label-loading hidden>One moment…</span>
        </button>
      </div>
      <p id="form-error" role="alert" class="mt-4 text-sm text-red-700 hidden"></p>
      <p class="mt-4 text-xs text-stone leading-relaxed">
        Secure payment handled by Stripe. By continuing you accept the
        <a href="/gift-cards/terms" class="underline">gift card terms &amp; conditions</a>.
        Valid for {GIFT_CARD_EXPIRY_YEARS} years from the date of issue.
      </p>
    </section>
  </form>

  <!-- How it works -->
  <section class="bg-cream-50 py-16 lg:py-20">
    <div class="max-w-5xl mx-auto px-5 lg:px-8">
      <p class="text-xs uppercase tracking-[0.18em] text-tan-600 mb-3 text-center">How it works</p>
      <h2 class="text-center text-2xl lg:text-3xl text-charcoal mb-10">Four easy steps.</h2>
      <div class="grid md:grid-cols-4 gap-5">
        {[
          { n: "1", t: "Choose", b: "Pick the service and how you'd like it delivered." },
          { n: "2", t: "Pay", b: "Secure Stripe checkout — Apple Pay, card, or Google Pay." },
          { n: "3", t: "Deliver", b: "We email a branded PDF gift card with a unique code." },
          { n: "4", t: "Redeem", b: "They book online or call us, then use the code in clinic." },
        ].map((s) => (
          <div class="p-5 rounded-2xl bg-white border border-sage-100">
            <p class="font-display text-3xl text-sage-600 leading-none">{s.n}</p>
            <h3 class="mt-3 text-charcoal font-display text-lg">{s.t}</h3>
            <p class="mt-1.5 text-sm text-stone leading-relaxed">{s.b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script
    is:inline
    define:vars={{ services: GIFT_CARD_SERVICES }}
  >
    (function () {
      const form = document.getElementById("gift-card-form");
      if (!form) return;

      const summaryTotal = document.getElementById("summary-total");
      const summaryService = document.getElementById("summary-service");
      const errorEl = document.getElementById("form-error");
      const btn = document.getElementById("submitBtn");
      const labelDefault = btn.querySelector("[data-label-default]");
      const labelLoading = btn.querySelector("[data-label-loading]");
      const recipientEmailWrap = document.getElementById("recipientEmailWrap");
      const recipientEmailInput = document.getElementById("recipientEmail");

      const svcById = (id) => services.find((s) => s.id === id);

      function updateSummary() {
        const sel = form.querySelector('input[name="serviceId"]:checked');
        if (!sel) return;
        const s = svcById(sel.value);
        if (!s) return;
        summaryTotal.textContent = `$${s.priceAud}`;
        summaryService.textContent = s.short;
      }

      function updateDeliveryUI() {
        const method = form.querySelector('input[name="deliveryMethod"]:checked')?.value;
        const toFriend = method === "email-friend";
        recipientEmailInput.required = toFriend;
        recipientEmailWrap.style.opacity = toFriend ? "1" : "0.55";
      }

      form.addEventListener("change", (e) => {
        if (e.target.name === "serviceId") updateSummary();
        if (e.target.name === "deliveryMethod") updateDeliveryUI();
      });

      updateSummary();
      updateDeliveryUI();

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorEl.classList.add("hidden");
        btn.disabled = true;
        labelDefault.hidden = true;
        labelLoading.hidden = false;

        const fd = new FormData(form);
        const payload = {
          serviceId: fd.get("serviceId"),
          deliveryMethod: fd.get("deliveryMethod"),
          buyerName: fd.get("buyerName")?.trim(),
          buyerEmail: fd.get("buyerEmail")?.trim(),
          recipientName: fd.get("recipientName")?.trim(),
          recipientEmail: fd.get("recipientEmail")?.trim(),
          personalMessage: fd.get("personalMessage")?.trim(),
          sendOn: fd.get("sendOn") || null,
        };

        try {
          const resp = await fetch("/.netlify/functions/create-checkout-session", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          const data = await resp.json();
          if (!resp.ok || !data.url) {
            throw new Error(data.error || "Couldn't start checkout. Please try again.");
          }
          window.location.href = data.url;
        } catch (err) {
          errorEl.textContent = err.message || "Something went wrong. Please try again.";
          errorEl.classList.remove("hidden");
          btn.disabled = false;
          labelDefault.hidden = false;
          labelLoading.hidden = true;
        }
      });
    })();
  </script>
</Layout>
